{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "owe-payroll",
  "account_id": "5e99f0578b4db40e6c3f9c86ceb6ad4d",

  // Custom entrypoint rather than .open-next/worker.js directly: it re-exports
  // OpenNext's fetch handler and adds the scheduled() handler for the two cron
  // jobs that used to live in vercel.json. See worker.ts.
  "main": "./worker.ts",

  "compatibility_date": "2026-09-17",
  // Required by OpenNext, and by node:crypto — salaryCrypto.ts needs
  // createCipheriv/aes-256-gcm, which nodejs_compat provides.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Hyperdrive pools and caches connections to the Supabase Postgres database.
  // Point it at Supabase's DIRECT connection (port 5432), not the Supavisor
  // pooler on 6543 — Hyperdrive does the pooling itself.
  // Config "owe-payroll-supabase" → db.usmqpeutnpzmtonnxucg.supabase.co:5432
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "af95137bcb554189bcaf47068b5ddf1e"
    }
  ],

  // custom_domain: true makes Cloudflare create and manage the DNS record for
  // team.ourworldenergy.com in the ourworldenergy.com zone.
  "routes": [
    {
      "pattern": "team.ourworldenergy.com",
      "custom_domain": true
    }
  ],

  "triggers": {
    // Cloudflare cron is always UTC. Arizona does not observe DST, so
    // America/Phoenix is UTC-7 all year and these need no seasonal fixup.
    //
    // worksnap-sync runs every 3 hours across the Arizona working day, so the
    // "Last updated" figure on /admin/attendance stays fresh rather than
    // showing one overnight pull:
    //   15:00 UTC = 08:00 AZ    18:00 UTC = 11:00 AZ    21:00 UTC = 14:00 AZ
    //   00:00 UTC = 17:00 AZ    03:00 UTC = 20:00 AZ
    // Every gap is >= 1 hour, which keeps each run in Cloudflare's 15-minute
    // CPU tier for cron triggers rather than the 30-second one.
    //
    // Keep these in step with the JOBS map in worker.ts — it dispatches on the
    // exact cron string, so an edit here alone would stop the job firing.
    "crons": [
      "0 0,3,15,18,21 * * *", // worksnap-sync — 8am/11am/2pm/5pm/8pm Arizona
      "0 9 * * *" // leave-balance-reset — 2am Arizona
    ]
  },

  // Keep the workers.dev URL alive as a DNS-independent fallback for testing.
  "workers_dev": true,

  "observability": {
    "enabled": true
  },

  "vars": {
    "NODE_ENV": "production"
  }
}
