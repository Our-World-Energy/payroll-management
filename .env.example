# ── Database (Supabase Postgres) ──────────────────────────────────────
# Pooled connection (Supavisor / pgbouncer — port 6543). Used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432). Used by Prisma for migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ── Supabase Auth (client-side, public) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-supabase-anon-key>"

# ── Salary encryption & visibility ────────────────────────────────────
# 32-byte master key (64 hex chars) that encrypts every salary / payment
# figure at rest (AES-256-GCM, see src/lib/salaryCrypto.ts). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy outside the database and the repo — without it the encrypted
# figures are unrecoverable. Never rotate it without re-encrypting first.
SALARY_MASTER_KEY=""
# Comma-separated admin emails allowed to unlock salary data (they get the
# email-OTP popup; everyone else sees masked figures). More can be added in
# Settings → Salary Visibility; these bootstrap the first viewer.
SALARY_VIEWER_EMAILS="you@ourworldenergy.com"

# ── Transactional email (SendGrid) — used for the salary OTP ─────────
# API key from sendgrid.com → Settings → API Keys. Needs the "mail.send"
# scope. Without it the OTP cannot be delivered and salary unlock fails.
SENDGRID_API_KEY=""
# Sender address. Must be on a domain authenticated in SendGrid (or a
# verified single sender). ourworldenergy.com is domain-authenticated, so any
# address on it works. Accepts "Name <addr@host>" or a bare address.
MAIL_FROM="team@ourworldenergy.com"
